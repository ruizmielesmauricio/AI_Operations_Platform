# Root env file — used by docker-compose to wire local services together.
# Copy to .env before running `docker compose up`. Never commit the real .env.

# --- Local Postgres (mirrors Neon in production, per 07_Deployment_Guide.md) ---
POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops_dev_password
POSTGRES_DB=aiops_dev
POSTGRES_PORT=5432

# --- Backend (see backend/.env.example for the full list) ---
DATABASE_URL=postgresql+psycopg://aiops:aiops_dev_password@db:5432/aiops_dev

# --- Frontend (see frontend/.env.example for the full list) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
