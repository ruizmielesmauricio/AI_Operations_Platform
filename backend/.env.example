# Copy to backend/.env for local (non-Docker) development.
# In docker-compose, these are supplied as service environment variables instead.

# --- Database (Neon in production; local Postgres container in dev) ---
DATABASE_URL=postgresql+psycopg://aiops:aiops_dev_password@localhost:5432/aiops_dev

# --- Auth (Supabase Auth — identity only, per ADR-013) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Object storage (Cloudflare R2 — S3-compatible, free tier for prototype) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- AI (OpenRouter, called ONLY from app/ai/ — see 05_AI_Architecture.md) ---
OPENROUTER_API_KEY=

# --- Billing (Stripe test mode for the prototype — never live keys here) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend free tier) ---
RESEND_API_KEY=

# --- App ---
ENVIRONMENT=local
ALLOWED_ORIGINS=http://localhost:3000
