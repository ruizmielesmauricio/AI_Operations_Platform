# Copy to backend/.env for local (non-Docker) development.
# In docker-compose, these are supplied as service environment variables instead.

# --- Database (Neon in production; local Postgres container in dev) ---
DATABASE_URL=postgresql+psycopg://aiops:aiops_dev_password@localhost:5432/aiops_dev

# --- Auth (Supabase Auth — identity only, per ADR-013) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Object storage (Cloudflare R2 — S3-compatible, free tier for prototype) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- AI (OpenRouter, called ONLY from app/ai/ — see 05_AI_Architecture.md) ---
OPENROUTER_API_KEY=

# --- Billing (Stripe test mode for the prototype — never live keys here) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID for the €80/month subscription (Dashboard > Product catalog)
STRIPE_PRICE_ID=
# Price ID for an additional branch, €30/month (Dashboard > Product catalog)
STRIPE_BRANCH_PRICE_ID=
# Price ID for a paid employee seat, €5/month, up to 2 per business
# (Dashboard > Product catalog)
STRIPE_EMPLOYEE_SEAT_PRICE_ID=

# --- Email (Resend free tier, app/email/ — used for the employee-seat
# invite email, PD-employee-seats). Without both of these set, invite
# emails are skipped silently (logged, never blocks adding an employee) —
# the owner can always just tell the employee to sign up directly.
RESEND_API_KEY=
# The "from" address Resend sends as — needs a verified sending domain,
# or use Resend's own no-setup test address (onboarding@resend.dev) for
# local testing.
RESEND_FROM_EMAIL=

# --- Address validation + timezone (Geoapify free tier, app/geocoding/) ---
GEOAPIFY_API_KEY=

# --- App ---
ENVIRONMENT=local
ALLOWED_ORIGINS=http://localhost:3000
# Used to build Stripe Checkout success/cancel redirect URLs
APP_BASE_URL=http://localhost:3000
